#!/usr/bin/env python3

import sys
import code

class Shell(code.InteractiveConsole):
    def write(data,error):
        print(data)
        if (error):
            print(error)

cons = Shell()

file_contents = sys.stdin
## kill first line
## file_contents.readline()

prompt = ">>> "

for line in file_contents:
    if( line.strip() == "" ):
        print("")
        ## or we will not get the end of indentation block
        cons.push("")
        prompt = ">>> "
    else:
        print(prompt + line,)
        if cons.push(line.rstrip()):
            prompt = "... "
        else:
            prompt = ">>> "
